{
  "name": "nowadays-desktop-renderer",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "test": "node --import ../node_modules/tsx/dist/loader.mjs --test tests/*.test.ts",
    "typecheck": "node ../../../scripts/ensure-tools.mjs && tsc --noEmit",
    "tokens": "node ../scripts/generate-character-theme.mjs",
    "tokens:check": "node ../scripts/generate-character-theme.mjs --check",
    "lint:styles": "node ../scripts/check-design-tokens.mjs",
    "check": "npm run tokens:check && npm run lint:styles && npm run typecheck"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "postcss": "8.5.32",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}
