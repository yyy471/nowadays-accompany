{
  "name": "nowadays-desk",
  "productName": "Nowadays Desk",
  "version": "0.1.2",
  "description": "Nowadays 桌面书桌",
  "author": "Nowadays",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "start": "npm --prefix renderer run build && electron .",
    "test": "node --test tests/unit/*.test.cjs && npm --prefix renderer test",
    "check": "npm --prefix renderer run check",
    "package:win": "npm run prepare:win && npm --prefix renderer run build && electron-builder --win portable --x64 --publish never",
    "prepare:win": "node scripts/prepare-package-resources.mjs"
  },
  "devDependencies": {
    "electron": "39.8.10",
    "electron-builder": "26.15.3",
    "pngjs": "6.0.0",
    "tsx": "4.23.15"
  },
  "build": {
    "appId": "app.nowadays.desk",
    "files": ["renderer/dist/**", "electron/main.cjs", "electron/window-intent.cjs", "electron/settings-preload.cjs", "electron/backend-paths.cjs", "electron/backend-log.cjs", "electron/master-key.cjs", "electron/extension-protocol.cjs", "assets/window.png", "assets/window.ico"],
    "extraResources": [
      {
        "from": "build-staging/node-runtime",
        "to": "node-runtime"
      },
      {
        "from": "build-staging/backend",
        "to": "backend",
        "filter": [
          "dist/**/*",
          "package.json",
          "package-lock.json"
        ]
      },
      {
        "from": "build-staging/backend/node_modules",
        "to": "backend/node_modules"
      },
      {
        "from": "build-staging/pi-mcp",
        "to": "pi-mcp",
        "filter": [
          "src/**/*",
          "package.json",
          "package-lock.json"
        ]
      },
      {
        "from": "build-staging/pi-mcp/node_modules",
        "to": "pi-mcp/node_modules"
      },
      {
        "from": "build-staging/preset-assets",
        "to": "preset-assets"
      }
    ],
    "win": {
      "icon": "assets/window.ico",
      "signExecutable": false
    },
    "portable": {
      "artifactName": "Nowadays-Desk-${version}-win-x64.exe"
    }
  }
}
