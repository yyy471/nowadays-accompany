{
  "name": "nowadays-desk",
  "productName": "Nowadays Desk",
  "version": "0.1.2",
  "description": "Nowadays 桌面书桌",
  "author": "Nowadays",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "start": "npm --prefix renderer run build && electron .",
    "test": "node --test tests/*.test.cjs",
    "check": "npm --prefix renderer run check",
    "package:win": "npm --prefix renderer run build && electron-builder --win portable --x64 --publish never"
  },
  "devDependencies": {
    "electron": "39.8.10",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "app.nowadays.desk",
    "files": ["renderer/dist/**", "main.cjs", "assets/window.png", "assets/window.ico"],
    "win": {
      "icon": "assets/window.ico",
      "signExecutable": false
    },
    "portable": {
      "artifactName": "Nowadays-Desk-${version}-win-x64.exe"
    }
  }
}
